model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  icon        String?
  description String? @db.Text

  articles Article[]
  games    Game[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ArticleType {
  NEWS
  REVIEW
  GUIDE
  FEATURE
}

model Article {
  id         String  @id @default(uuid())
  title      String
  excerpt    String?
  content    String  @db.Text
  coverImage String?
  heroImage  String?
  videoUrl   String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  gameId     String?
  game       Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  tags String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  articleType ArticleType @default(NEWS)

  isFeatured Boolean @default(false)

  publishedAt   DateTime @default(now())
  readTime      Int?
  viewCount     Int      @default(0)
  commentsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([gameId])
  @@index([authorId])
  @@index([isFeatured])
}

model Game {
  id                 String    @id @default(uuid())
  title              String
  description        String?   @db.Text
  content            String    @db.Text
  coverImage         String?
  videoUrl           String?
  developer          String?
  publisher          String?
  releaseDate        DateTime?
  platforms          String[]
  downloadLinks      String?
  systemRequirements String?   @db.Text
  rating             Float?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       String[]

  articles   Article[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  isFeatured Boolean @default(false)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured])
}
